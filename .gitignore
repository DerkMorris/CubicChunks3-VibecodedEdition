/mods/cubicchunks/fabric/src/main/resources/cubicchunks.mixins.access.json
/mods/cubicchunks/fabric/src/main/resources/cubicchunks.dasm.json
/mods/cubicchunks/fabric/src/test/resources/cubicchunks.mixins.test.json
/mods/cubicchunks/fabric/src/worldSmoke/resources/cubicchunks.mixins.world_smoke.json

