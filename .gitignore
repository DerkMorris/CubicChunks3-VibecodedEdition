**/.idea/*
!**/.idea/codeStyles/
!**/.idea/inspectionProfiles/
*.ipr
*.iws
*.iml

# Eclipse
*.launch
.settings/
.metadata/
.classpath
.project
eclipse/

# Minecraft development clients, servers and test worlds
run/
runs/
logs/
crash-reports/

# Loader / transformer caches and debug output
.fabric/
.mixin.out/
.dasm.out/
forge*changelog.txt

# Generated by :cubicchunks:fabric:genAll (keep hand-written and legacy configs)
